{
  "name": "trugurpala/turkiye-iban",
  "description": "Turkish IBAN validation and provider lookup for PHP.",
  "type": "library",
  "license": "MIT",
  "require": { "php": ">=8.2" },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": { "psr-4": { "TurkiyeIban\\": "src/" }, "files": ["src/functions.php"] },
  "autoload-dev": { "psr-4": { "TurkiyeIban\\Tests\\": "tests/" } },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse src --level=8",
    "prepare-assets": "php scripts/prepare-assets.php"
  },
  "extra": { "branch-alias": { "dev-main": "0.1-dev" } }
}
